---
// Flat, non-personalised information page: everything guests need, revisitable any time.
// All content lives in the objects below. Edit there, not in the markup.
import RsvpForm from '../components/details/RsvpForm.astro';
import SiteFonts from '../components/SiteFonts.astro';
import { withPhoneLinks } from '../components/details/phone';

const BASE = import.meta.env.BASE_URL;

// The page no longer opens with the date and venue: the invitation sent with
// the link has both (Amelia, October 2026). The date heads The day, the venue
// Getting there, and both are in the footer.
const date = 'Friday 16 April 2027';

// `note`: a line under the stop, in smaller type; `party`: in rainbow colours, its letters in a wave.
const schedule: { time: string; name: string; note?: string; party?: true }[] = [
  { time: '3:00 pm', name: 'Gates open', note: 'Sandwiches & lemonade' },
  { time: '3:30 pm', name: 'Ceremony' },
  { time: '4:00 pm', name: 'Cocktail hour' },
  { time: '5:30 pm', name: 'Dinner in the Orangery' },
  { time: '7:00 pm', name: 'Speeches & dances' },
  { time: '8:00 pm', name: 'Paaartayyy', party: true },
  { time: '11:30 pm', name: 'Send-off' },
];

const venue = {
  name: 'Jasper’s Berry',
  // Not "Berry": the venue is in Jaspers Brush, as its address says.
  place: 'New South Wales',
  address: '4 O’Keeffes Lane, Jaspers Brush NSW 2535',
  // Directions links: each opens the maps app on phones, or the website on desktop.
  googleMapsUrl: 'https://www.google.com/maps/dir/?api=1&destination=4+O%27Keeffes+Lane,+Jaspers+Brush+NSW+2535',
  appleMapsUrl: 'https://maps.apple.com/?daddr=4+O%27Keeffes+Lane,+Jaspers+Brush+NSW+2535',
  travel: [
    { name: 'Driving', note: 'About 45 minutes south of Wollongong. There’s plenty of parking on site.' },
    { name: 'Bus', note: 'We’re running a bus to the venue from Berry, Gerringong and Kiama, and back again after the send-off. We’ll confirm exactly where it stops once we know where everyone’s staying.' },
    { name: 'Train', note: 'South Coast line to Kiama, then hop on the wedding bus. Taxis and Ubers are hard to come by, so book in advance if you need one.' },
  ],
};

// Before the places to stay, as a paragraph of its own: it isn't a place.
const schoolHolidays = 'The wedding falls in the NSW school holidays, so book in early!';

// The bus stopping in each town is said once, under Getting there.
const stay = [
  { name: 'In Berry', note: 'Guesthouses and cottages, a short drive from the venue.' },
  { name: 'In Gerringong', note: 'By the sea, a short drive from the venue.' },
  { name: 'In Kiama', note: 'The most hotels, apartments and holiday parks.' },
];

// Its own section, Make a weekend of it, after Where to stay, beside the photo
// that used to stand alone below it (Amelia, October 2026). "A casual dinner
// and drinks" is meant to say, gently, that guests pay their own way.
// When it is: said here and in the RSVP's dinner question.
const dinner = { day: 'Thursday 15 April', time: '6pm' };
const nightBefore = {
  before: `On ${dinner.day}, the night before, we’re booking some large tables at the Berry Hotel for ${dinner.time}. We’d love you to join us for a casual dinner and drinks. Please see `,
  menu: { text: 'the menu here', href: 'https://theberryhotel.com.au/wp-content/uploads/2026/10/Bistro_Menu_Sept2026_-_A3_-_The_Berry_Hotel_V5.pdf' },
  after: ' and let us know in your RSVP.',
};

// The serious answers first, then the jokes.
const faqs = [
  { q: 'What should I wear?', a: 'Black tie optional – suits with ties and longer dresses.' },
  { q: 'What about gifts?', a: 'We’ll have a wishing well on the day.' },
  { q: 'What if it rains?', a: 'It won’t rain, don’t worry so much.' },
  { q: 'Who do I ask about everything else?', a: 'Call Jonathon Dale any time, day or night, on 0435 597 406.' },
];

const rsvp = {
  replyBy: '16 February 2027',
  dinnerWhen: `${dinner.day}, ${dinner.time}`,
  // Where guests can reach us if the form fails to send.
  email: 'patrickcorbett12@gmail.com',
  phone: '0435 597 406',
};

const photos = {
  hero: { src: 'gerringong-film-10.jpg', alt: 'Patrick twirling Amelia on a green hillside at golden hour' },
  dance: { src: 'gerringong-film-12.jpg', alt: 'Patrick and Amelia holding hands in a paddock at sunset' },
  embrace: { src: 'gerringong-film-3.jpg', alt: 'Amelia resting her head on Patrick’s chest in golden light' },
};
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex,nofollow" />
    <link rel="icon" type="image/svg+xml" href={`${BASE}favicon.svg`} />
    <meta name="theme-color" content="#fdf9ea" />
    <title>Patrick &amp; Amelia · The details</title>
    <meta name="description" content="Everything you need for Patrick and Amelia’s wedding: the day, where to stay." />
    <SiteFonts display="swap" />
  </head>
  <body>
    <main class="info">
      <header class="info-header">
        <a class="info-monogram" href={BASE} data-story aria-label="Back to the story" style={`--logo: url(${BASE}logo.png)`}><img src={`${BASE}logo.png`} alt="P and A monogram" width="284" height="192" /></a>
        <div class="info-header-links">
          <a class="info-story-link" href={BASE} data-story>The story</a>
          <a class="info-rsvp-link" href="#rsvp">RSVP</a>
        </div>
      </header>

      <!-- At the top, where the date and venue were, so it's in reach from the
           first screen on a phone, with short labels so it nearly fits one,
           and without RSVP, which is always beside it in the header (Amelia,
           October 2026). The section being read is underlined. -->
      <nav class="info-nav" aria-label="On this page" data-info-nav>
        <a href="#day">Day</a><a href="#venue">Travel</a><a href="#stay">Stay</a><a href="#dinner">Dinner</a><a href="#faq">Q&amp;A</a>
      </nav>

      <section class="info-hero">
        <div class="info-hero-copy">
          <h1>What you<br /><em>need to know.</em></h1>
        </div>
        <figure class="info-photo info-hero-photo">
          <img src={`${BASE}photos/${photos.hero.src}`} alt={photos.hero.alt} width="1800" height="2714" fetchpriority="high" />
        </figure>
      </section>

      <section id="day" class="info-section info-day">
        <p class="info-eyebrow">{date}</p>
        <h2>The <em>day.</em></h2>
        <ol class="info-schedule">
          {schedule.map(item => <li>
            <span class="info-time">{item.time}</span>
            {item.party
              ? <span class="info-stop info-stop-party"><span class="info-visually-hidden">{item.name}</span>{[...item.name].map((letter, i) => <span aria-hidden="true" style={`--i: ${i}`}>{letter}</span>)}</span>
              : <span class="info-stop">{item.name}</span>}
            {item.note && <span class="info-stop-note">{item.note}</span>}
          </li>)}
        </ol>
      </section>

      <section id="venue" class="info-section info-venue">
        <div>
          <h2>Getting <em>there.</em></h2>
          <p class="info-venue-name">{venue.name}</p>
          <p class="info-address">{venue.address}</p>
          <div class="info-map-links">
            <a class="info-map-link" href={venue.googleMapsUrl} rel="noopener">Open in Google Maps</a>
            <a class="info-map-link" href={venue.appleMapsUrl} rel="noopener">Open in Apple Maps</a>
          </div>
          <dl class="info-list">
            {venue.travel.map(row => <>
              <dt>{row.name}</dt>
              <dd>{row.note}</dd>
            </>)}
          </dl>
        </div>
      </section>

      <section id="stay" class="info-section info-split info-split-reverse">
        <figure class="info-photo info-photo-tilt-right">
          <img src={`${BASE}photos/${photos.dance.src}`} alt={photos.dance.alt} width="1400" height="2111" loading="lazy" />
        </figure>
        <div>
          <h2>Where <em>to stay.</em></h2>
          <p class="info-lead">{schoolHolidays}</p>
          <dl class="info-list">
            {stay.map(row => <>
              <dt>{row.name}</dt>
              <dd>{row.note}</dd>
            </>)}
          </dl>
        </div>
      </section>

      <section id="dinner" class="info-section info-split">
        <figure class="info-photo info-photo-tilt-left">
          <img src={`${BASE}photos/${photos.embrace.src}`} alt={photos.embrace.alt} width="1400" height="2111" loading="lazy" />
        </figure>
        <div>
          <h2>Make a <em>weekend of it.</em></h2>
          <p class="info-lead">{nightBefore.before}<a class="info-text-link" href={nightBefore.menu.href} target="_blank" rel="noopener">{nightBefore.menu.text}</a>{nightBefore.after}</p>
        </div>
      </section>

      <section id="faq" class="info-section info-faq-section">
        <h2>Q&amp;A</h2>
        <div class="info-faqs">
          {faqs.map(faq => <div class="info-faq">
            <h3>{faq.q}</h3>
            <p>{withPhoneLinks(faq.a).map(part => part.tel ? <a class="info-tel" href={part.tel}>{part.text}</a> : part.text)}</p>
          </div>)}
        </div>
      </section>

      <section id="rsvp" class="info-rsvp">
        <svg class="info-boat" width="40" height="34" viewBox="0 0 28 24" fill="none" aria-hidden="true">
          <path d="m2 13 12 3 12-3-6 8H8L2 13Zm5 1 7-11 7 11M14 3v13" stroke="currentColor" stroke-width="1" stroke-linejoin="round" />
        </svg>
        <RsvpForm {...rsvp} />
      </section>

      <footer class="info-footer">
        <span class="info-monogram" style={`--logo: url(${BASE}logo.png)`}><img src={`${BASE}logo.png`} alt="P and A monogram" width="284" height="192" /></span>
        <p>{date} · {venue.name}, {venue.place}</p>
      </footer>
    </main>
  </body>
</html>

<script>
  // "The story" and the monogram go back to the Garden: to the guest's own
  // Personal link when this browser has been given one, and straight into
  // the scene, without the opening's butterflies, at the place they left if
  // the Garden kept one (pa_voyage_back and pa_voyage_place, voyagePlace.ts).
  import { readParty } from '../components/details/rsvp';
  const party = (() => { try { return readParty(localStorage.getItem('pa_party')); } catch { return null; } })();
  for (const link of document.querySelectorAll<HTMLAnchorElement>('[data-story]')) {
    if (party && /^[a-z0-9-]+$/.test(party.code)) link.href = `${import.meta.env.BASE_URL}${party.code}/`;
    link.addEventListener('click', () => { try { sessionStorage.setItem('pa_voyage_back', '1'); } catch { /* private mode: the opening as usual */ } });
  }

  // The nav underlines the section being read: the last one whose top has
  // passed a line a third of the way down the screen. None in the opening,
  // nor once the RSVP is reached, as it has no link of its own. On a phone,
  // where the links run off the side, the nav slides to keep that one in view.
  const nav = document.querySelector<HTMLElement>('[data-info-nav]')!;
  const links = [...nav.querySelectorAll<HTMLAnchorElement>('a')];
  const sections = [...links.map(link => document.querySelector<HTMLElement>(link.hash)!), document.getElementById('rsvp')!];
  let current: HTMLAnchorElement | undefined;
  let queued = false;
  function markCurrent() {
    queued = false;
    const line = innerHeight / 3;
    const reading = sections.filter(section => section.getBoundingClientRect().top <= line).at(-1);
    const link = links.find(link => link.hash === `#${reading?.id}`);
    if (link === current) return;
    current?.removeAttribute('aria-current');
    link?.setAttribute('aria-current', 'location');
    current = link;
    if (link && nav.scrollWidth > nav.clientWidth) {
      const smooth = !matchMedia('(prefers-reduced-motion: reduce)').matches;
      nav.scrollTo({ left: link.offsetLeft - (nav.clientWidth - link.offsetWidth) / 2, behavior: smooth ? 'smooth' : 'auto' });
    }
  }
  const queue = () => { if (!queued) { queued = true; requestAnimationFrame(markCurrent); } };
  addEventListener('scroll', queue, { passive: true });
  addEventListener('resize', queue);
  markCurrent();
</script>

<style is:global>
  @view-transition { navigation: auto; }
  /* The invitations' cream paper and dark brown ink (Amelia, October 2026),
     as in the invitation sent to the Parties (STYLES in dev/invite). The
     original sage is kept below in case Patrick prefers it: set
     data-theme="sage" on <html>, and theme-color to #eeeee5. */
  :root { --page: #fdf9ea; --ink: #4e3324; --soft: #6b4f3e; --muted: #7d6858; --leaf: #a08b74; --deep: #4e3324; --on-deep: #fdf9ea;
    --paper: #fffcf2; --line: #8a7663; --shadow: #5a4030; --focus: #8a6a50; --select: #eadfbf; }
  :root[data-theme=sage] { --page: #eeeee5; --ink: #384135; --soft: #59634f; --muted: #66715e; --leaf: #7a826d; --deep: #414d3d; --on-deep: #f6f3e7;
    --paper: #f7f3e8; --line: #737967; --shadow: #48513a; --focus: #6e775c; --select: #b9c2a7; }
  html { background: var(--page); scroll-behavior: smooth; }
  body { margin: 0; }
  ::selection { background: var(--select); color: var(--ink); }
  @media (prefers-reduced-motion: reduce) { html { scroll-behavior: auto; } }
</style>

<style>
  .info { --info-header-h: 86px;
    color: var(--ink); font-family: 'Montserrat', sans-serif; overflow-x: clip; }
  .info a { color: inherit; text-decoration: none; }
  .info a:focus-visible { outline: 2px solid var(--focus); outline-offset: 7px; }

  .info-eyebrow { font-size: 12px; text-transform: uppercase; letter-spacing: .24em; line-height: 1.8; color: var(--muted); margin: 0; }
  h1, h2 { font-family: 'Cormorant Garamond', Georgia, serif; font-weight: 400; letter-spacing: -.045em; margin: 20px 0 18px; }
  h1 { font-size: clamp(58px, 6.8vw, 108px); line-height: .98; font-weight: 300; }
  h1 em, h2 em { font-weight: 300; color: var(--soft); }
  h2 { font-size: clamp(42px, 4.4vw, 66px); line-height: 1; }


  /* The header and the section nav both stay: the nav sticks just under the
     header, its top tucked beneath the header's soft edge, rather than
     sliding under it (October 2026). */
  .info-header { position: sticky; top: 0; z-index: 5; display: flex; align-items: center; justify-content: space-between; box-sizing: border-box;
    height: var(--info-header-h); padding: 0 48px; background: linear-gradient(var(--page) calc(100% - 16px), color-mix(in srgb, var(--page) 0%, transparent)); }
  .info-monogram { display: block; line-height: 0; }
  .info-header .info-monogram { padding: 5px 0; }
  .info-monogram img { display: block; width: auto; height: 34px; }
  /* The monogram in the theme's ink, as on the invitations: the image keeps
     its size and alt text, and its shape masks the ink over it. */
  .info-monogram { background: var(--ink); -webkit-mask: var(--logo) content-box center / contain no-repeat; mask: var(--logo) content-box center / contain no-repeat; }
  .info-monogram img { opacity: 0; }
  .info .info-rsvp-link { position: relative; font-size: 11px; font-weight: 500; letter-spacing: .2em; text-transform: uppercase; color: var(--on-deep);
    background: var(--deep); border-radius: 999px; padding: 11px 19px 11px 21px; transition: background-color .3s; }
  /* A thumb-sized target round the slim pill. */
  .info .info-rsvp-link::after { content: ''; position: absolute; inset: -6px -4px; }
  .info .info-rsvp-link:hover { background: var(--soft); }
  .info-header-links { display: flex; align-items: center; gap: 26px; }
  .info .info-story-link { position: relative; font-size: 11px; font-weight: 500; letter-spacing: .2em; text-transform: uppercase;
    text-decoration: underline; text-decoration-color: color-mix(in srgb, var(--line) 44%, transparent); text-underline-offset: 6px; }
  .info .info-story-link::after { content: ''; position: absolute; inset: -14px -8px; }

  .info-hero { display: flex; align-items: center; gap: clamp(40px, 6vw, 90px); max-width: 1180px; margin: 0 auto; padding: clamp(30px, 6vh, 80px) 48px 40px; }
  .info-hero-copy { flex: 1.2; }

  .info-photo { flex: 1; margin: 0; padding: 12px; background: var(--paper); box-shadow: 0 14px 50px color-mix(in srgb, var(--shadow) 14%, transparent); max-width: 400px; }
  .info-photo img { width: 100%; height: auto; display: block; }
  .info-hero-photo { rotate: 2deg; }
  .info-photo-tilt-left { rotate: -2.5deg; }
  .info-photo-tilt-right { rotate: 2deg; }

  .info-nav { position: sticky; top: calc(var(--info-header-h) - 16px); z-index: 4; display: flex; gap: clamp(18px, 3.5vw, 44px);
    padding: 6px 24px 14px; margin: -16px 0 0; font-size: 12px; text-transform: uppercase; letter-spacing: .2em; background: linear-gradient(var(--page) calc(100% - 14px), color-mix(in srgb, var(--page) 0%, transparent)); }
  /* Centred while they fit; from the start, scrolling sideways, when they don't. */
  .info-nav a:first-child { margin-left: auto; }
  .info-nav a:last-child { margin-right: auto; }
  .info-nav a { flex: none; display: flex; align-items: center; min-height: 44px; box-sizing: border-box; padding-top: 2px; border-bottom: 1px solid transparent; transition: border-color .3s; white-space: nowrap; }
  .info-nav a:hover { border-color: color-mix(in srgb, var(--line) 44%, transparent); }
  .info-nav a[aria-current] { border-color: var(--ink); }
  /* A link to a section lands below the header and nav. */
  .info section[id] { scroll-margin-top: calc(var(--info-header-h) + 50px); }

  .info-section { max-width: 1180px; margin: 0 auto; padding: clamp(60px, 10vh, 120px) 48px 0; }
  .info-day { text-align: center; padding-top: clamp(30px, 5vh, 60px); }
  .info-time { font-size: 12px; letter-spacing: .16em; text-transform: uppercase; color: var(--muted); white-space: nowrap; }
  .info-stop { font: 400 25px/1.2 'Cormorant Garamond', Georgia, serif; letter-spacing: -.02em; }
  .info-stop-note { font: italic 17px/1.3 'Cormorant Garamond', Georgia, serif; color: var(--muted); }
  /* "Paaartayyy" in a rainbow sliding through the letters, a calmer cousin
     of Slack's party parrot, its letters rising and falling in a gentle wave
     along the word (Amelia, October 2026); held still under reduced motion.
     A moving letter drops out of a background clipped to the whole word, so
     each letter carries the rainbow itself, shifted by about where it sits in
     the word (--x), so together they read as one. The colours are deep
     enough to read on the paper. */
  .info-stop-party { font-weight: 500; }
  .info-stop-party > [aria-hidden] { --x: calc(var(--i) * -.46em); display: inline-block; color: transparent; -webkit-background-clip: text; background-clip: text;
    background-image: linear-gradient(90deg, #c8463d, #d27a1e, #b8961a, #4d9447, #2f86a6, #4b62c2, #8a4fb8, #c24589, #c8463d);
    background-size: 9em 100%; background-position: var(--x) 0;
    animation: info-party 4s linear infinite, info-wave 2.4s ease-in-out calc(var(--i) * .14s - 2.4s) infinite; }
  @keyframes info-party { from { background-position: var(--x) 0; } to { background-position: calc(var(--x) + 9em) 0; } }
  @keyframes info-wave { 0%, 100% { transform: translateY(.06em); } 50% { transform: translateY(-.1em); } }
  .info-visually-hidden { position: absolute; width: 1px; height: 1px; overflow: hidden; clip-path: inset(50%); white-space: nowrap; }
  @media (prefers-reduced-motion: reduce) { .info-stop-party > [aria-hidden] { animation: none; } }

  /* The schedule as a printed order of service, framed like the photos. */
  .info-schedule { list-style: none; margin: 50px auto 0; max-width: 400px; padding: 56px 40px; background: var(--paper); box-shadow: 0 14px 50px color-mix(in srgb, var(--shadow) 14%, transparent);
    outline: 1px solid color-mix(in srgb, var(--line) 24%, transparent); outline-offset: -14px; rotate: -1deg; }
  .info-schedule li { display: flex; flex-direction: column; align-items: center; gap: 6px; }
  .info-schedule li + li::before { content: ''; width: 3px; height: 3px; border-radius: 50%; background: var(--leaf); margin: 14px 0 12px; }

  .info-venue { text-align: center; }
  .info-venue .info-list dd { margin-inline: auto; }
  .info-venue .info-map-links { justify-content: center; }
  .info-split { display: flex; align-items: center; gap: clamp(45px, 7vw, 110px); }
  .info-split > div { flex: 1.15; }
  .info-split-reverse { flex-direction: row-reverse; }
  .info-venue-name { font: italic 23px 'Cormorant Garamond', Georgia, serif; color: var(--soft); margin: 6px 0 4px; }
  .info-address { font-size: 13px; letter-spacing: .06em; color: var(--muted); margin: 0 0 8px; }
  .info-list { margin: 26px 0 0; }
  .info-lead { font: 20px/1.5 'Cormorant Garamond', Georgia, serif; max-width: 430px; margin: 22px 0 0; }
  .info-list dt { font-size: 11px; text-transform: uppercase; letter-spacing: .18em; color: var(--muted); padding-top: 18px; }
  .info-list dd { font: 18px/1.5 'Cormorant Garamond', Georgia, serif; margin: 7px 0 0; max-width: 430px; }
  .info-map-links { display: flex; flex-wrap: wrap; gap: 10px; margin-top: 20px; }
  .info .info-map-link { font-size: 11px; font-weight: 500; letter-spacing: .2em; text-transform: uppercase; color: var(--deep);
    border: 1px solid color-mix(in srgb, var(--deep) 50%, transparent); border-radius: 999px; padding: 13px 19px 13px 21px; transition: background-color .3s, color .3s; }
  .info .info-map-link:hover { background: var(--deep); color: var(--on-deep); }

  .info-faq-section h2 { text-align: center; }
  .info-faqs { margin: 45px auto 0; columns: 2; column-gap: clamp(45px, 6vw, 90px); max-width: 1020px; }
  .info-faq { break-inside: avoid; padding: 0 0 34px; }
  .info-faq h3 { font: 500 23px 'Cormorant Garamond', Georgia, serif; letter-spacing: -.02em; margin: 0 0 8px; }
  .info-faq p { font: 17px/1.5 'Cormorant Garamond', Georgia, serif; color: var(--ink); margin: 0; max-width: 430px; }
  /* Numbers in the answers ring when tapped; links in running text are underlined the same way. */
  .info .info-tel, .info .info-text-link { white-space: nowrap; border-bottom: 1px solid color-mix(in srgb, var(--line) 44%, transparent); }

  .info-rsvp { text-align: center; max-width: 700px; margin: 0 auto; padding: clamp(80px, 13vh, 150px) 48px; }
  .info-boat { color: var(--leaf); }

  .info-footer { text-align: center; padding: 30px 24px 55px; }
  .info-footer .info-monogram { display: inline-block; }
  .info-footer .info-monogram img { height: 28px; }
  .info-footer p { font-size: 11px; letter-spacing: .16em; text-transform: uppercase; color: var(--muted); margin-top: 12px; }

  /* Gentle rise-and-fade as sections enter the viewport; browsers without
     scroll-driven animations (or with reduced motion) simply show everything. */
  @supports (animation-timeline: view()) {
    @media (prefers-reduced-motion: no-preference) {
      .info-section > *, .info-rsvp > * {
        animation: info-rise linear both;
        animation-timeline: view();
        animation-range: entry 0% entry 55%;
      }
    }
  }
  @keyframes info-rise {
    from { opacity: 0; transform: translateY(18px); }
