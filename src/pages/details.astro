---
// Flat, non-personalised information page: everything guests need, revisitable any time.
// All content lives in the objects below. Edit there, not in the markup.
// Anything wrapped in tbc() renders with a soft "to be confirmed" mark until replaced.
import RsvpForm from '../components/details/RsvpForm.astro';
import SiteFonts from '../components/SiteFonts.astro';
import { withPhoneLinks } from '../components/details/phone';

const BASE = import.meta.env.BASE_URL;

const tbcValues = new Set<string>();
const tbc = (placeholder: string) => { tbcValues.add(placeholder); return placeholder; };

// `note`: a line under the stop, in smaller type.
const schedule: { time: string; name: string; note?: string }[] = [
  { time: '3:00 pm', name: 'Gates open', note: 'Arrive any time before the ceremony' },
  { time: '3:30 pm', name: 'Ceremony' },
  { time: '4:00 pm', name: 'Cocktail hour' },
  { time: '5:30 pm', name: 'Dinner in the Orangery' },
  { time: '7:00 pm', name: 'Speeches & dances' },
  { time: '8:00 pm', name: 'Party begins' },
  { time: '8:00 pm', name: 'Dessert' },
  { time: '11:30 pm', name: 'Send-off' },
];

const venue = {
  name: 'Jasper’s Berry',
  // Not "Berry": the venue is in Jaspers Brush, as its address says.
  place: 'New South Wales',
  address: '4 O’Keeffes Lane, Jaspers Brush NSW 2535',
  // Directions links: each opens the maps app on phones, or the website on desktop.
  googleMapsUrl: 'https://www.google.com/maps/dir/?api=1&destination=4+O%27Keeffes+Lane,+Jaspers+Brush+NSW+2535',
  appleMapsUrl: 'https://maps.apple.com/?daddr=4+O%27Keeffes+Lane,+Jaspers+Brush+NSW+2535',
  travel: [
    { name: 'Driving', note: 'About 45 minutes south of Wollongong, and there is plenty of parking on site.' },
    { name: 'Bus', note: tbc('We’re running a bus to and from the venue, stopping at Wollongong, Gerringong and Berry. Times to come.') },
    { name: 'Train', note: 'South Coast line to Berry station, then a ten-minute taxi.' },
  ],
};

const stay = [
  { name: 'The night before', note: 'We’re booking some large tables at the Berry Hotel for dinner on Thursday 15 April, for anyone who’d like to join us. Let us know in your RSVP.' },
  { name: 'In Berry village', note: 'Guesthouses and cottages a short drive from the venue. Berry weekends fill up, so book early.' },
  { name: 'In Gerringong', note: 'By the sea, with a bus stop there on the way to the venue and home again.' },
  { name: 'Around the countryside', note: 'Airbnbs across Jaspers Brush, Broughton Village and the surrounding hills.' },
  { name: 'Our recommendations', note: tbc('We’ll add specific places we love here.') },
];

const faqs = [
  { q: 'What should I wear?', a: 'Black tie optional – suits with ties and longer dresses.' },
  { q: 'What if it rains?', a: 'It won’t rain, don’t worry so much.' },
  { q: 'What about dietary requirements?', a: 'Tell us when you RSVP and we’ll take care of the rest.' },
  { q: 'Are there gifts?', a: 'We will have a wishing well on the day.' },
  { q: 'Would you rather lemons for hands or lemons for feet?', a: 'Depends how ripe they are.' },
  { q: 'Who do I ask about everything else?', a: 'Call Jonathan Dale anytime, day or night, on 0435 597 406.' },
];

const rsvp = {
  replyBy: '16 February 2027',
  busHint: 'Stopping at Wollongong, Gerringong and Berry. Times to come.',
  // Where guests can reach us if the form fails to send.
  email: 'patrickcorbett12@gmail.com',
  phone: '0435 597 406',
};

const photos = {
  hero: { src: 'gerringong-film-10.jpg', alt: 'Patrick twirling Amelia on a green hillside at golden hour' },
  dance: { src: 'gerringong-film-12.jpg', alt: 'Patrick and Amelia holding hands in a paddock at sunset' },
  embrace: { src: 'gerringong-film-3.jpg', alt: 'Amelia resting her head on Patrick’s chest in golden light' },
};
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex,nofollow" />
    <link rel="icon" type="image/svg+xml" href={`${BASE}favicon.svg`} />
    <meta name="theme-color" content="#eeeee5" />
    <title>Patrick &amp; Amelia · The details</title>
    <meta name="description" content="Everything you need for Patrick and Amelia’s wedding: the day, the garden, where to stay." />
    <SiteFonts display="swap" />
  </head>
  <body>
    <main class="info">
      <header class="info-header">
        <a class="info-monogram" href={BASE} data-story aria-label="Back to the story"><img src={`${BASE}logo.png`} alt="P and A monogram" width="284" height="192" /></a>
        <span class="info-header-date">16 APRIL 2027</span>
        <div class="info-header-links">
          <a class="info-story-link" href={BASE} data-story>The story</a>
          <a class="info-rsvp-link" href="#rsvp">RSVP</a>
        </div>
      </header>

      <section class="info-hero">
        <div class="info-hero-copy">
          <h1>What you<br /><em>need to know.</em></h1>
          <div class="info-date-row"><span>Friday 16 April 2027</span><i></i><span>{venue.name}, {venue.place}</span></div>
        </div>
        <figure class="info-photo info-hero-photo">
          <img src={`${BASE}photos/${photos.hero.src}`} alt={photos.hero.alt} width="1800" height="2714" fetchpriority="high" />
        </figure>
      </section>

      <nav class="info-nav" aria-label="On this page">
        <a href="#day">The day</a><a href="#venue">Getting there</a><a href="#stay">Where to stay</a><a href="#faq">Questions</a><a href="#rsvp">RSVP</a>
      </nav>

      <section id="day" class="info-section info-day">
        <h2>The <em>day.</em></h2>
        <ol class="info-schedule">
          {schedule.map(item => <li>
            <span class="info-time">{item.time}</span>
            <span class="info-stop">{item.name}</span>
            {item.note && <span class="info-stop-note">{item.note}</span>}
          </li>)}
        </ol>
      </section>

      <section id="venue" class="info-section info-venue">
        <div>
          <p class="info-eyebrow">The garden</p>
          <h2>Getting <em>there.</em></h2>
          <p class="info-venue-name">{venue.name}</p>
          <p class="info-address">{venue.address}</p>
          <div class="info-map-links">
            <a class="info-map-link" href={venue.googleMapsUrl} rel="noopener">Open in Google Maps</a>
            <a class="info-map-link" href={venue.appleMapsUrl} rel="noopener">Open in Apple Maps</a>
          </div>
          <dl class="info-list">
            {venue.travel.map(row => <>
              <dt>{row.name}</dt>
              <dd class:list={{ 'is-tbc': tbcValues.has(row.note) }}>{row.note}</dd>
            </>)}
          </dl>
        </div>
      </section>

      <section id="stay" class="info-section info-split info-split-reverse">
        <figure class="info-photo info-photo-tilt-right">
          <img src={`${BASE}photos/${photos.dance.src}`} alt={photos.dance.alt} width="1400" height="2111" loading="lazy" />
        </figure>
        <div>
          <p class="info-eyebrow">Make a weekend of it</p>
          <h2>Where <em>to stay.</em></h2>
          <dl class="info-list">
            {stay.map(row => <>
              <dt>{row.name}</dt>
              <dd class:list={{ 'is-tbc': tbcValues.has(row.note) }}>{row.note}</dd>
            </>)}
          </dl>
        </div>
      </section>

      <figure class="info-photo info-photo-tilt-left info-photo-break">
        <img src={`${BASE}photos/${photos.embrace.src}`} alt={photos.embrace.alt} width="1400" height="2111" loading="lazy" />
      </figure>

      <section id="faq" class="info-section info-faq-section">
        <h2>Q&amp;A</h2>
        <div class="info-faqs">
          {faqs.map(faq => <div class="info-faq">
            <h3>{faq.q}</h3>
            <p class:list={{ 'is-tbc': tbcValues.has(faq.a) }}>{withPhoneLinks(faq.a).map(part => part.tel ? <a class="info-tel" href={part.tel}>{part.text}</a> : part.text)}</p>
          </div>)}
        </div>
      </section>

      <section id="rsvp" class="info-rsvp">
        <svg class="info-boat" width="40" height="34" viewBox="0 0 28 24" fill="none" aria-hidden="true">
          <path d="m2 13 12 3 12-3-6 8H8L2 13Zm5 1 7-11 7 11M14 3v13" stroke="currentColor" stroke-width="1" stroke-linejoin="round" />
        </svg>
        <RsvpForm {...rsvp} />
      </section>

      <footer class="info-footer">
        <span class="info-monogram"><img src={`${BASE}logo.png`} alt="P and A monogram" width="284" height="192" /></span>
        <p>Friday 16 April 2027 · {venue.name}, {venue.place}</p>
      </footer>
    </main>
  </body>
</html>

<script>
  // "The story" and the monogram go back to the Garden: to the guest's own
  // Personal link when this browser has been given one, and straight into
  // the scene, without the opening's butterflies, at the place they left if
  // the Garden kept one (pa_voyage_back and pa_voyage_place, voyagePlace.ts).
  import { readParty } from '../components/details/rsvp';
  const party = (() => { try { return readParty(localStorage.getItem('pa_party')); } catch { return null; } })();
  for (const link of document.querySelectorAll<HTMLAnchorElement>('[data-story]')) {
    if (party && /^[a-z0-9-]+$/.test(party.code)) link.href = `${import.meta.env.BASE_URL}${party.code}/`;
    link.addEventListener('click', () => { try { sessionStorage.setItem('pa_voyage_back', '1'); } catch { /* private mode: the opening as usual */ } });
  }
</script>

<style is:global>
  @view-transition { navigation: auto; }
  html { background: #eeeee5; scroll-behavior: smooth; }
  body { margin: 0; }
  ::selection { background: #b9c2a7; color: #30382e; }
  @media (prefers-reduced-motion: reduce) { html { scroll-behavior: auto; } }
</style>

<style>
  .info { --ink: #384135; --muted: #66715e; --leaf: #7a826d; --deep: #414d3d; --paper: #f7f3e8; --info-header-h: 86px;
    color: var(--ink); font-family: 'Montserrat', sans-serif; overflow-x: clip; }
  .info a { color: inherit; text-decoration: none; }
  .info a:focus-visible { outline: 2px solid #6e775c; outline-offset: 7px; }

  .info-eyebrow { font-size: 9px; text-transform: uppercase; letter-spacing: .28em; line-height: 1.8; color: var(--muted); margin: 0; }
  h1, h2 { font-family: 'Cormorant Garamond', Georgia, serif; font-weight: 400; letter-spacing: -.045em; margin: 20px 0 18px; }
  h1 { font-size: clamp(58px, 6.8vw, 108px); line-height: .98; font-weight: 300; }
  h1 em, h2 em { font-weight: 300; color: #59634f; }
  h2 { font-size: clamp(42px, 4.4vw, 66px); line-height: 1; }

  .is-tbc { position: relative; }
  .is-tbc::after { content: 'to confirm'; font: 500 7px 'Montserrat', sans-serif; letter-spacing: .14em; text-transform: uppercase;
    color: #8b6158c9; border: 1px solid #8b615826; border-radius: 20px; padding: 2px 7px; margin-left: 9px; vertical-align: 2px; white-space: nowrap; }


  /* The header and the section nav both stay: the nav sticks just under the
     header, its top tucked beneath the header's soft edge, rather than
     sliding under it (October 2026). */
  .info-header { position: sticky; top: 0; z-index: 5; display: flex; align-items: center; justify-content: space-between; box-sizing: border-box;
    height: var(--info-header-h); padding: 0 48px; background: linear-gradient(#eeeee5 calc(100% - 16px), #eeeee500); }
  .info-monogram { display: block; line-height: 0; }
  .info-header .info-monogram { padding: 5px 0; }
  .info-monogram img { display: block; width: auto; height: 34px; }
  .info-header-date { position: absolute; left: 50%; transform: translateX(-50%); font-size: 9px; letter-spacing: .26em; }
  .info .info-rsvp-link { position: relative; font-size: 9px; font-weight: 500; letter-spacing: .2em; text-transform: uppercase; color: var(--paper);
    background: var(--deep); border-radius: 999px; padding: 11px 19px 11px 21px; transition: background-color .3s; }
  /* A thumb-sized target round the slim pill. */
  .info .info-rsvp-link::after { content: ''; position: absolute; inset: -6px -4px; }
  .info .info-rsvp-link:hover { background: #59634f; }
  .info-header-links { display: flex; align-items: center; gap: 26px; }
  .info .info-story-link { position: relative; font-size: 9px; font-weight: 500; letter-spacing: .2em; text-transform: uppercase;
    text-decoration: underline; text-decoration-color: #73796770; text-underline-offset: 6px; }
  .info .info-story-link::after { content: ''; position: absolute; inset: -14px -8px; }

  .info-hero { display: flex; align-items: center; gap: clamp(40px, 6vw, 90px); max-width: 1180px; margin: 0 auto; padding: clamp(30px, 6vh, 80px) 48px 40px; }
  .info-hero-copy { flex: 1.2; }
  .info-date-row { margin-top: 34px; display: flex; align-items: center; flex-wrap: wrap; gap: 15px; font-size: 9px; text-transform: uppercase; letter-spacing: .23em; }
  .info-date-row i { width: 3px; height: 3px; border-radius: 50%; background: var(--leaf); }

  .info-photo { flex: 1; margin: 0; padding: 12px; background: var(--paper); box-shadow: 0 14px 50px #48513a24; max-width: 400px; }
  .info-photo img { width: 100%; height: auto; display: block; }
  .info-hero-photo { rotate: 2deg; }
  .info-photo-tilt-left { rotate: -2.5deg; }
  .info-photo-tilt-right { rotate: 2deg; }

  .info-nav { position: sticky; top: calc(var(--info-header-h) - 16px); z-index: 4; display: flex; gap: clamp(18px, 3.5vw, 44px);
    padding: 6px 24px 14px; margin: 20px 0 0; font-size: 11px; text-transform: uppercase; letter-spacing: .2em; background: linear-gradient(#eeeee5 calc(100% - 14px), #eeeee500); }
  /* Centred while they fit; from the start, scrolling sideways, when they don't. */
  .info-nav a:first-child { margin-left: auto; }
  .info-nav a:last-child { margin-right: auto; }
  .info-nav a { flex: none; display: flex; align-items: center; min-height: 44px; box-sizing: border-box; padding-top: 2px; border-bottom: 1px solid transparent; transition: border-color .3s; white-space: nowrap; }
  .info-nav a:hover { border-color: #73796770; }
  /* A link to a section lands below the header and nav. */
  .info section[id] { scroll-margin-top: calc(var(--info-header-h) + 50px); }

  .info-section { max-width: 1180px; margin: 0 auto; padding: clamp(60px, 10vh, 120px) 48px 0; }
  .info-day { text-align: center; padding-top: clamp(30px, 5vh, 60px); }
  .info-time { font-size: 10px; letter-spacing: .16em; text-transform: uppercase; color: var(--muted); white-space: nowrap; }
  .info-stop { font: 400 25px/1.2 'Cormorant Garamond', Georgia, serif; letter-spacing: -.02em; }
  .info-stop-note { font: italic 17px/1.3 'Cormorant Garamond', Georgia, serif; color: var(--muted); }

  /* The schedule as a printed order of service, framed like the photos. */
  .info-schedule { list-style: none; margin: 50px auto 0; max-width: 400px; padding: 56px 40px; background: var(--paper); box-shadow: 0 14px 50px #48513a24;
    outline: 1px solid #7379673d; outline-offset: -14px; rotate: -1deg; }
  .info-schedule li { display: flex; flex-direction: column; align-items: center; gap: 6px; }
  .info-schedule li + li::before { content: ''; width: 3px; height: 3px; border-radius: 50%; background: var(--leaf); margin: 14px 0 12px; }

  .info-venue { text-align: center; }
  .info-venue .info-list dd { margin-inline: auto; }
  .info-venue .info-map-links { justify-content: center; }
  .info-photo-break { margin: clamp(70px, 11vh, 130px) auto 0; max-width: 340px; }
  .info-split { display: flex; align-items: center; gap: clamp(45px, 7vw, 110px); }
  .info-split > div { flex: 1.15; }
  .info-split-reverse { flex-direction: row-reverse; }
  .info-venue-name { font: italic 23px 'Cormorant Garamond', Georgia, serif; color: #59634f; margin: 6px 0 4px; }
  .info-address { font-size: 11px; letter-spacing: .06em; color: var(--muted); margin: 0 0 8px; }
  .info-list { margin: 26px 0 0; }
  .info-list dt { font-size: 9px; text-transform: uppercase; letter-spacing: .22em; color: var(--muted); padding-top: 18px; }
  .info-list dd { font: 18px/1.5 'Cormorant Garamond', Georgia, serif; margin: 7px 0 0; max-width: 430px; }
  .info-map-links { display: flex; flex-wrap: wrap; gap: 10px; margin-top: 20px; }
  .info .info-map-link { font-size: 9px; font-weight: 500; letter-spacing: .2em; text-transform: uppercase; color: var(--deep);
    border: 1px solid #414d3d80; border-radius: 999px; padding: 13px 19px 13px 21px; transition: background-color .3s, color .3s; }
  .info .info-map-link:hover { background: var(--deep); color: var(--paper); }

  .info-faq-section h2 { text-align: center; }
  .info-faqs { margin: 45px auto 0; columns: 2; column-gap: clamp(45px, 6vw, 90px); max-width: 1020px; }
  .info-faq { break-inside: avoid; padding: 0 0 34px; }
  .info-faq h3 { font: 500 23px 'Cormorant Garamond', Georgia, serif; letter-spacing: -.02em; margin: 0 0 8px; }
  .info-faq p { font: 17px/1.5 'Cormorant Garamond', Georgia, serif; color: var(--ink); margin: 0; max-width: 430px; }
  /* Numbers in the answers ring when tapped. */
  .info .info-tel { white-space: nowrap; border-bottom: 1px solid #73796770; }

  .info-rsvp { text-align: center; max-width: 700px; margin: 0 auto; padding: clamp(80px, 13vh, 150px) 48px; }
  .info-boat { color: var(--leaf); }

  .info-footer { text-align: center; padding: 30px 24px 55px; }
  .info-footer .info-monogram { display: inline-block; }
  .info-footer .info-monogram img { height: 28px; }
  .info-footer p { font-size: 8px; letter-spacing: .18em; text-transform: uppercase; color: var(--muted); margin-top: 12px; }

  /* Gentle rise-and-fade as sections enter the viewport; browsers without
     scroll-driven animations (or with reduced motion) simply show everything. */
  @supports (animation-timeline: view()) {
    @media (prefers-reduced-motion: no-preference) {
      .info-section > *, .info-rsvp > *, .info-photo-break {
        animation: info-rise linear both;
        animation-timeline: view();
        animation-range: entry 0% entry 55%;
      }
    }
  }
  @keyframes info-rise {
    from { opacity: 0; transform: translateY(18px); }
    to { opacity: 1; transform: none; }
  }

  @media (prefers-reduced-motion: no-preference) {
    /* Extra specificity: this must beat the scroll-fade rule (.info-rsvp > *)
       regardless of how the bundler merges media blocks. */
    .info .info-rsvp .info-boat { animation: info-bob 6s ease-in-out infinite; }
  }
  @keyframes info-bob {
    0%, 100% { transform: translateY(0) rotate(-2.5deg); }
    50% { transform: translateY(-6px) rotate(2.5deg); }
  }

  @media (hover: hover) and (prefers-reduced-motion: no-preference) {
    .info-photo { transition: translate .5s ease, box-shadow .5s ease; }
    .info-photo:hover { translate: 0 -8px; box-shadow: 0 24px 60px #48513a30; }
  }

  @media (max-width: 860px) {
    .info { --info-header-h: 74px; }
    .info-header { padding: 0 24px; }
    .info-header .info-monogram img { height: 30px; }
    .info-header-date { display: none; }
    .info-hero { flex-direction: column; padding: 20px 28px 10px; text-align: center; }
    .info-date-row { flex-direction: column; gap: 10px; }
    .info-date-row i { display: none; }
    .info-hero-photo { max-width: 330px; margin-top: 20px; }
    /* One row: on a phone it scrolls sideways, its ends fading, rather than
       wrapping into a second row of sticky links. */
    .info-nav { gap: 22px; padding: 2px 24px 12px; letter-spacing: .14em; overflow-x: auto; scrollbar-width: none; overscroll-behavior-x: contain;
      -webkit-mask-image: linear-gradient(90deg, transparent, #000 24px, #000 calc(100% - 24px), transparent); mask-image: linear-gradient(90deg, transparent, #000 24px, #000 calc(100% - 24px), transparent); }
    .info-nav::-webkit-scrollbar { display: none; }
    .info-section { padding: 65px 28px 0; }
    .info-split, .info-split-reverse { flex-direction: column; align-items: center; text-align: center; }
    .info-split .info-photo, .info-photo-break { max-width: 300px; }
    .info-list dd, .info-faq p { margin-inline: auto; }
    .info-stop { font-size: 23px; }
    .info-schedule { padding: 48px 24px; }
    .info-day { padding-top: 24px; }
    .info-map-links { flex-wrap: nowrap; justify-content: center; gap: 8px; }
    .info .info-map-link { flex: 1 1 0; max-width: 175px; padding: 13px 8px; letter-spacing: .1em; text-align: center; }
    .info-faqs { columns: 1; text-align: center; }
    .info-rsvp { padding: 90px 28px 110px; }
  }
</style>
