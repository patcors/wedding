---
import Layout from "../../layouts/Layout.astro";
import { guests } from "../../data/guests";

const validSlugs = guests.map((g) => g.slug);
const base = import.meta.env.BASE_URL;
---

<Layout
  title="Patrick & Amelia · Invitation"
  description="Enter your invitation code to view the full details and RSVP."
>
  <main class="relative min-h-screen flex items-center justify-center px-6 py-24 overflow-hidden">
    <!-- Sunburst background -->
    <svg
      aria-hidden="true"
      class="absolute inset-0 m-auto w-[90vmin] h-[90vmin] max-w-none text-mustard opacity-30 spin-slow"
      viewBox="-100 -100 200 200"
    >
      <g stroke="currentColor" stroke-width="0.6" fill="none">
        {Array.from({ length: 36 }).map((_, i) => (
          <line
            x1="0" y1="0"
            x2={Math.cos((i * Math.PI) / 18) * 96}
            y2={Math.sin((i * Math.PI) / 18) * 96}
            opacity={i % 3 === 0 ? 0.9 : 0.3}
          />
        ))}
        <circle r="42" stroke-width="0.5" />
        <circle r="72" stroke-width="0.3" stroke-dasharray="2 4" />
      </g>
    </svg>

    <article class="relative z-10 max-w-sm w-full text-center">
      <p class="label">An invitation · MMXXVII</p>

      <h1
        class="mt-8 font-display leading-[0.85] tracking-[-0.02em]"
        style="font-variation-settings:'opsz' 144,'SOFT' 60,'WONK' 1;"
      >
        <span class="block text-[clamp(3rem,14vw,5.5rem)]">Patrick</span>
        <span class="block font-serif italic text-ink-soft text-[clamp(1.2rem,4vw,2rem)] my-1">&amp;</span>
        <span
          class="block text-[clamp(3rem,14vw,5.5rem)] italic text-terracotta-deep"
          style="font-variation-settings:'opsz' 144,'SOFT' 100,'WONK' 1;"
        >Amelia</span>
      </h1>

      <p class="mt-6 font-mono text-sm tracking-[0.4em] uppercase text-ink">16 · 04 · 2027</p>
      <p class="mt-2 font-serif italic text-lg text-ink-soft">Jasper's Berry &middot; Berry, NSW</p>

      <hr class="mt-12 mb-10 border-0 h-px bg-ink/20 mx-auto w-24" />

      <p class="font-serif text-lg text-ink-soft mb-8">
        Enter your invitation code to see the full details and RSVP.
      </p>

      <form id="code-form" novalidate class="flex flex-col items-center gap-3">
        <input
          id="code-input"
          type="text"
          autocomplete="off"
          autocapitalize="none"
          spellcheck="false"
          placeholder="word-word"
          class="w-full max-w-[16rem] bg-transparent border-0 border-b-2 border-ink/40 focus:border-terracotta focus:outline-none py-2 text-center text-xl font-mono tracking-widest placeholder:text-ink/30 transition-colors"
        />
        <p
          id="code-error"
          class="hidden font-serif italic text-sm"
          style="color: var(--color-terracotta-deep);"
        >
          That code wasn't found — double-check your invitation.
        </p>
        <button
          type="submit"
          class="mt-4 group inline-flex items-center gap-3 bg-ink text-cream px-8 py-4 font-mono text-xs tracking-[0.32em] uppercase hover:bg-terracotta transition-colors"
        >
          <span>Open invitation</span>
          <svg
            width="22" height="10" viewBox="0 0 22 10" fill="none"
            class="transition-transform group-hover:translate-x-1"
          >
            <path d="M0 5h20M16 1l4 4-4 4" stroke="currentColor" stroke-width="1.4"/>
          </svg>
        </button>
      </form>
    </article>

    <!-- Footer ornament -->
    <svg
      aria-hidden="true"
      class="absolute bottom-6 left-1/2 -translate-x-1/2 text-terracotta-deep"
      width="36" height="36" viewBox="-18 -18 36 36"
    >
      <g stroke="currentColor" stroke-width="1.2">
        <line x1="-15" y1="0" x2="15" y2="0" />
        <line x1="0" y1="-15" x2="0" y2="15" />
        <line x1="-11" y1="-11" x2="11" y2="11" />
        <line x1="-11" y1="11" x2="11" y2="-11" />
      </g>
      <circle r="2.5" fill="currentColor" />
    </svg>
  </main>
</Layout>

<script define:vars={{ validSlugs, base }}>
  const form = document.getElementById("code-form");
  const input = document.getElementById("code-input");
  const error = document.getElementById("code-error");

  form?.addEventListener("submit", (e) => {
    e.preventDefault();
    const code = input.value.trim().toLowerCase();
    if (validSlugs.includes(code)) {
      error?.classList.add("hidden");
      window.location.assign(`${base}invitation/${code}/`);
    } else {
      error?.classList.remove("hidden");
      input.focus();
      input.select();
    }
  });

  input?.addEventListener("input", () => {
    error?.classList.add("hidden");
  });
</script>
