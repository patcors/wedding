---
// Isolated PROTOTYPE route: the agreed reflective garden direction for review.
import GardenPrototype from '../components/garden/GardenPrototype';
const invitationHref = `${import.meta.env.BASE_URL}invitation/`;
---
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex,nofollow" />
    <title>Patrick & Amelia — Garden study</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,300;0,400;0,500;1,300;1,400&family=Montserrat:wght@400;500&display=swap" rel="stylesheet" />
    <style is:global>html { background: #eeeee5; } body { margin: 0; } ::selection { background: #b9c2a7; color: #30382e; } astro-dev-toolbar { display: none; }</style>
  </head>
  <body>
    <GardenPrototype client:only="react" />
    <noscript><main style="padding:20vh 24px;text-align:center;font-family:Georgia,serif;color:#384135"><h1>Patrick &amp; Amelia</h1><p>16 April 2027 · Jasper’s Berry</p><a href={invitationHref}>Open your invitation</a></main></noscript>
  </body>
</html>
