---
// The page around the Garden, shared by the generic landing page and every
// Party's Personal link. A Party page greets them and remembers them so the
// Details page can show their RSVP. The Garden renders here on the server, so
// its opening text and cover paint before any script arrives.
import Garden from './Garden';
import { DAWN, MIST_DAWN, type SkyKey } from './skyCycle';
import type { Party } from '../../data/parties';

interface Props { party?: Party }
const { party } = Astro.props;
const BASE = import.meta.env.BASE_URL;
const title = party ? `${party.greeting}, you're invited` : 'Patrick & Amelia';
const description = 'Patrick & Amelia · Friday 16 April 2027 · Jasper’s Berry';
const image = new URL(`${BASE}og.jpg`, Astro.site).href;
const remembered = party && { code: party.code, greeting: party.greeting, guests: party.guests };
// The page opens in the dawn sky's colours, so the cover, the opening copy and
// Safari's bars match the scene before it arrives (GardenSky takes over from
// these). The bars keep the dawn's top colour all the way down.
const opening = (key: SkyKey) => ({ '--garden-page': key.zenith, '--garden-sky-top': key.zenith, '--garden-sky-glow': key.glow, '--garden-ink-on-sky': key.ink });
const devMist = import.meta.env.DEV && opening(MIST_DAWN);
---
<html lang="en" data-garden-state="loading" style={opening(DAWN)}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="robots" content="noindex,nofollow" />
    <meta name="theme-color" content={DAWN.zenith} />
    <title>{party ? `${party.greeting} · Patrick & Amelia` : 'Patrick & Amelia · 16 April 2027'}</title>
    <meta name="description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={image} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Patrick twirling Amelia on a green hillside at golden hour" />
    <meta name="twitter:card" content="summary_large_image" />
    <link rel="icon" type="image/svg+xml" href={`${BASE}favicon.svg`} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,300;0,400;0,500;1,300;1,400&family=Montserrat:wght@400;500&display=block" rel="stylesheet" />
    <script is:inline>
      // The Garden runs its scene to the bottom of the physical screen, under
      // Safari's toolbar (see garden.css). iOS doesn't swap screen sizes when
      // the phone turns, so pick the side that matches the orientation.
      (function () {
        var set = function () {
          var long = Math.max(screen.width, screen.height), short = Math.min(screen.width, screen.height);
          document.documentElement.style.setProperty('--garden-screen', (innerWidth > innerHeight ? short : long) + 'px');
        };
        set(); addEventListener('resize', set);
        // The scene is taller than the page under Safari's toolbar, so the
        // page itself could be scrolled by up to the toolbar's height, which
        // lifts the header under the status bar and leaves a band below the
        // scene (seen on an iPhone, October 2026). Only <main> scrolls: put
        // the page back whenever anything moves it.
        var pin = function () { var root = document.scrollingElement; if (root && (root.scrollTop || root.scrollLeft)) root.scrollTo(0, 0); };
        addEventListener('scroll', pin, { passive: true });
        addEventListener('resize', pin);
        addEventListener('pageshow', pin);
      })();
    </script>
    <style is:global>@view-transition { navigation: auto; } html { background: var(--garden-page); } body { margin: 0; } ::selection { background: #b9c2a7; color: #30382e; }</style>
    {devMist && <script is:inline define:vars={{ devMist }}>
      // Dev only: Safari colours its status bar and toolbar from the page at
      // load, so the Review panel's old misty sky reloads the page and opens in
      // the mist's colours here.
      try {
        if (localStorage.getItem('pa_dev_sky') === 'mist') {
          for (var name in devMist) document.documentElement.style.setProperty(name, devMist[name]);
          document.querySelector('meta[name="theme-color"]').content = devMist['--garden-page'];
        }
      } catch {}
    </script>}
    {remembered && <script is:inline define:vars={{ remembered }}>
      try { localStorage.setItem('pa_party', JSON.stringify(remembered)); } catch {}
    </script>}
  </head>
  <body>
    <Garden client:load />
    <noscript><style>.garden-arrival-actions .garden-details-fallback { opacity: 1; visibility: visible; } .garden-loading { visibility: hidden; }</style></noscript>
  </body>
</html>
