---
// The site's two typefaces, Cormorant Garamond and Montserrat, served from
// public/fonts rather than Google Fonts (see docs/VOYAGE.md, "Fonts"). The
// same files and faces Google's stylesheet gave (css2?family=Cormorant+
// Garamond:ital,wght@0,300;0,400;0,500;1,300;1,400&family=Montserrat:wght@400;500),
// in its order, so the pages set exactly as before; but with nothing to fetch
// from another server first, and the faces declared in the page itself, the
// browser starts on the files at once. `preload` names files the first paint
// needs, fetched alongside the page's stylesheet. Both are OFL.
interface Props { display: 'block' | 'swap'; preload?: string[] }
const { display, preload = [] } = Astro.props;
const BASE = import.meta.env.BASE_URL;
const SUBSETS = {
  'cyrillic-ext': 'U+0460-052F, U+1C80-1C8A, U+20B4, U+2DE0-2DFF, U+A640-A69F, U+FE2E-FE2F',
  cyrillic: 'U+0301, U+0400-045F, U+0490-0491, U+04B0-04B1, U+2116',
  vietnamese: 'U+0102-0103, U+0110-0111, U+0128-0129, U+0168-0169, U+01A0-01A1, U+01AF-01B0, U+0300-0301, U+0303-0304, U+0308-0309, U+0323, U+0329, U+1EA0-1EF9, U+20AB',
  'latin-ext': 'U+0100-02BA, U+02BD-02C5, U+02C7-02CC, U+02CE-02D7, U+02DD-02FF, U+0304, U+0308, U+0329, U+1D00-1DBF, U+1E00-1E9F, U+1EF2-1EFF, U+2020, U+20A0-20AB, U+20AD-20C4, U+2113, U+2C60-2C7F, U+A720-A7FF',
  latin: 'U+0000-00FF, U+0131, U+0152-0153, U+02BB-02BC, U+02C6, U+02DA, U+02DC, U+0304, U+0308, U+0329, U+2000-206F, U+20AC, U+2122, U+2191, U+2193, U+2212, U+2215, U+FEFF, U+FFFD',
};
// Each style is one variable file per subset, declared once for each weight used.
const STYLES = [['Cormorant Garamond', 'italic', [300, 400]], ['Cormorant Garamond', 'normal', [300, 400, 500]], ['Montserrat', 'normal', [400, 500]]] as const;
const fontFile = (family: string, style: string, subset: string) => `${BASE}fonts/${family.toLowerCase().replaceAll(' ', '-')}-${style}-${subset}.woff2`;
const faces = STYLES.flatMap(([family, style, weights]) => weights.flatMap(weight => Object.entries(SUBSETS).map(([subset, range]) =>
  `@font-face{font-family:'${family}';font-style:${style};font-weight:${weight};font-display:${display};src:url(${fontFile(family, style, subset)}) format('woff2');unicode-range:${range}}`))).join('');
---
{preload.map(file => <link rel="preload" href={`${BASE}fonts/${file}`} as="font" type="font/woff2" crossorigin />)}
<style is:inline set:html={faces} />
