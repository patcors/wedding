---
// The RSVP at the foot of the Details page. The page is the same for everyone,
// so the Party is read on the client from what their Personal link left in
// localStorage (pa_party). Every RSVP belongs to a Party, so without one the
// visitor is pointed back to their Personal link (or to us) instead of a form.
// The guest list itself is never shipped here.
import { BUS_STOPS, DIETARY_OPTIONS } from './rsvp';
import { telHref } from './phone';

interface Props {
  replyBy: string;   // e.g. "16 February 2027"
  busHint: string;   // shown under the bus questions
  email: string;     // fallback contact: no Personal link, or sending fails
  phone: string;
}

const { replyBy, busHint, email, phone } = Astro.props;
const phoneHref = telHref(phone);
---
<div class="rsvp" data-rsvp data-reply-by={replyBy}>
  <h2 class="rsvp-heading" tabindex="-1" data-rsvp-heading>We’d love to <em>know you’re coming.</em></h2>
  <p class="rsvp-subtitle" data-rsvp-subtitle>Please reply by {replyBy}.</p>

  <div class="rsvp-no-link" data-rsvp-no-link hidden>
    <p class="rsvp-note">Your RSVP lives behind the personal link we sent you. Open it on this device and you’ll find your names waiting here.</p>
    <p class="rsvp-note">Can’t find it? Email <a href={`mailto:${email}`}>{email}</a> or text <a href={phoneHref}>{phone}</a> and we’ll sort it out.</p>
  </div>

  <p class="rsvp-note rsvp-loading" data-rsvp-loading hidden>Looking for your reply…</p>

  <form class="rsvp-form" data-rsvp-form novalidate hidden>
    <div class="rsvp-guests" data-rsvp-guests></div>

    <div class="rsvp-party">
      <label class="rsvp-field">
        <span class="rsvp-label">A song to get you dancing <i>optional</i></span>
        <input class="rsvp-input" name="song" type="text" autocomplete="off" />
      </label>
      <label class="rsvp-field">
        <span class="rsvp-label">Anything else we should know <i>optional</i></span>
        <textarea class="rsvp-input" name="notes" rows="2"></textarea>
      </label>
      <label class="rsvp-field">
        <span class="rsvp-label">A note for us <i>optional</i></span>
        <textarea class="rsvp-input" name="message" rows="2"></textarea>
      </label>
    </div>

    <div class="rsvp-actions">
      <button type="submit" class="rsvp-button" data-rsvp-submit>Send our reply</button>
      <p class="rsvp-failure" role="alert" data-rsvp-failure hidden>
        Something went wrong sending that. Please email <a href={`mailto:${email}`}>{email}</a> or text <a href={phoneHref}>{phone}</a>.
      </p>
    </div>
  </form>

  <div class="rsvp-thanks" data-rsvp-thanks hidden>
    <!-- Plain to see that it went through: just sent, or coming back to the page. -->
    <p class="rsvp-received" data-rsvp-received>
      <svg width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden="true"><circle cx="8" cy="8" r="7.4" stroke="currentColor" stroke-width=".9" /><path d="m4.8 8.3 2.2 2.2 4.3-4.6" stroke="currentColor" stroke-width="1.1" stroke-linecap="round" stroke-linejoin="round" /></svg>
      <span data-rsvp-received-text></span>
    </p>
    <ul class="rsvp-summary" data-rsvp-summary></ul>
    <p class="rsvp-note" data-rsvp-song hidden></p>
    <p class="rsvp-note" data-rsvp-notes hidden></p>
    <p class="rsvp-note" data-rsvp-reach></p>
    <button type="button" class="rsvp-button rsvp-button-quiet" data-rsvp-change>Change our answer</button>
  </div>

  <noscript>
    <p class="rsvp-note">To RSVP, email <a href={`mailto:${email}`}>{email}</a> or text <a href={phoneHref}>{phone}</a>.</p>
  </noscript>

  <template data-rsvp-guest-template>
    <div class="rsvp-guest" data-guest>
      <fieldset class="rsvp-attend" data-guest-attend>
        <legend class="rsvp-guest-name" data-guest-legend></legend>
        <div class="rsvp-pills">
          <label class="rsvp-pill"><input type="radio" value="yes" data-guest-attending /><span>Coming</span></label>
          <label class="rsvp-pill"><input type="radio" value="no" data-guest-attending /><span>Can’t make it</span></label>
        </div>
        <p class="rsvp-error" data-guest-attend-error hidden></p>
      </fieldset>
      <div class="rsvp-extras" data-guest-extras hidden>
        <fieldset class="rsvp-dietary">
          <legend class="rsvp-label">Dietary requirements <i>optional</i></legend>
          <div class="rsvp-pills rsvp-pills-diet">
            {DIETARY_OPTIONS.map(option => (
              <label class="rsvp-pill"><input type="checkbox" value={option} data-guest-diet /><span>{option}</span></label>
            ))}
            <label class="rsvp-pill"><input type="checkbox" data-guest-diet-other /><span>Other</span></label>
          </div>
          <label class="rsvp-field rsvp-diet-other" data-guest-diet-other-field hidden>
            <span class="rsvp-visually-hidden">Other dietary requirements</span>
            <input class="rsvp-input" type="text" autocomplete="off" placeholder="Tell us what you need" data-guest-dietary-other />
          </label>
        </fieldset>
        <fieldset class="rsvp-bus">
          <legend class="rsvp-label">Bus to the venue? <i>where you’ll get on</i></legend>
          <div class="rsvp-pills rsvp-pills-bus">
            <label class="rsvp-pill"><input type="radio" value="none" data-guest-bus-to /><span>No thanks</span></label>
            {BUS_STOPS.map(stop => <label class="rsvp-pill"><input type="radio" value={stop} data-guest-bus-to /><span>{stop}</span></label>)}
          </div>
        </fieldset>
        <fieldset class="rsvp-bus">
          <legend class="rsvp-label">Bus home? <i>where you’ll get off</i></legend>
          <div class="rsvp-pills rsvp-pills-bus">
            <label class="rsvp-pill"><input type="radio" value="none" data-guest-bus-from /><span>No thanks</span></label>
            {BUS_STOPS.map(stop => <label class="rsvp-pill"><input type="radio" value={stop} data-guest-bus-from /><span>{stop}</span></label>)}
          </div>
        </fieldset>
        <p class="rsvp-hint">{busHint}</p>
        <fieldset class="rsvp-dinner">
          <legend class="rsvp-label">Dinner at the Berry Hotel the night before? <i>Thursday 15 April</i></legend>
          <div class="rsvp-pills">
            <label class="rsvp-pill"><input type="radio" value="yes" data-guest-dinner /><span>Count me in</span></label>
            <label class="rsvp-pill"><input type="radio" value="no" data-guest-dinner /><span>No thanks</span></label>
          </div>
        </fieldset>
      </div>
    </div>
  </template>
</div>

<script>
  import {
    describeGuest, formatDietary, latestReply, lookupUrl, parseDietary, readLookup, readParty, readSaved, sentOn, storageKey,
    toParams,
    type Answer, type GuestReply, type RememberedParty, type Rsvp,
  } from './rsvp';

  const ENDPOINT: string = import.meta.env.PUBLIC_RSVP_ENDPOINT ?? '';

  const root = document.querySelector<HTMLElement>('[data-rsvp]')!;
  const $ = <T extends Element = HTMLElement>(selector: string, scope: ParentNode = root) => scope.querySelector<T>(selector)!;

  const heading = $('[data-rsvp-heading]');
  const subtitle = $('[data-rsvp-subtitle]');
  const form = $<HTMLFormElement>('[data-rsvp-form]');
  const noLink = $('[data-rsvp-no-link]');
  const loading = $('[data-rsvp-loading]');
  const guestList = $('[data-rsvp-guests]');
  const submit = $<HTMLButtonElement>('[data-rsvp-submit]');
  const failure = $('[data-rsvp-failure]');
  const thanks = $('[data-rsvp-thanks]');
  const template = $<HTMLTemplateElement>('[data-rsvp-guest-template]');
  const replyBy = root.dataset.replyBy ?? '';

  const party: RememberedParty | null = (() => {
    try { return readParty(localStorage.getItem('pa_party')); } catch { return null; }
  })();
  let rowId = 0;

  const field = (name: string) => form.elements.namedItem(name) as HTMLInputElement | HTMLTextAreaElement;
  const checked = (row: HTMLElement, hook: string) => row.querySelector<HTMLInputElement>(`[${hook}]:checked`)?.value ?? '';
  const check = (row: HTMLElement, hook: string, value: string) => {
    const input = row.querySelector<HTMLInputElement>(`[${hook}][value="${CSS.escape(value)}"]`);
    if (input) input.checked = true;  // a stop that's since been removed stays unanswered
  };
  const rows = () => [...guestList.querySelectorAll<HTMLElement>('[data-guest]')];

  function setHeading(text: string, emphasis: string) {
    heading.replaceChildren(`${text} `, Object.assign(document.createElement('em'), { textContent: emphasis }));
  }

  function showError(el: HTMLElement, message: string | null, control?: HTMLElement) {
    el.textContent = message ?? '';
    el.hidden = !message;
    control?.setAttribute('aria-invalid', String(Boolean(message)));
  }

  // ---- Guest rows ----------------------------------------------------------

  function addRow(name: string, answer?: GuestReply) {
    const id = `rsvp-g${rowId++}`;
    const row = (template.content.firstElementChild as HTMLElement).cloneNode(true) as HTMLElement;
    const attendError = $('[data-guest-attend-error]', row);
    const extras = $('[data-guest-extras]', row);
    const otherToggle = $<HTMLInputElement>('[data-guest-diet-other]', row);
    const otherField = $('[data-guest-diet-other-field]', row);
    const otherInput = $<HTMLInputElement>('[data-guest-dietary-other]', row);

    row.querySelectorAll<HTMLInputElement>('[data-guest-attending]').forEach(r => { r.name = `${id}-attending`; });
    row.querySelectorAll<HTMLInputElement>('[data-guest-bus-to]').forEach(r => { r.name = `${id}-bus-to`; });
    row.querySelectorAll<HTMLInputElement>('[data-guest-bus-from]').forEach(r => { r.name = `${id}-bus-from`; });
    row.querySelectorAll<HTMLInputElement>('[data-guest-dinner]').forEach(r => { r.name = `${id}-dinner`; });
    attendError.id = `${id}-attend-error`;
    $('[data-guest-attend]', row).setAttribute('aria-describedby', attendError.id);

    row.dataset.name = name;
    $('[data-guest-legend]', row).textContent = name;

    if (answer) {
      check(row, 'data-guest-attending', answer.attending);
      const { choices, other } = parseDietary(answer.dietary);
      row.querySelectorAll<HTMLInputElement>('[data-guest-diet]').forEach(box => { box.checked = choices.includes(box.value); });
      otherToggle.checked = Boolean(other);
      otherInput.value = other;
      if (answer.busTo) check(row, 'data-guest-bus-to', answer.busTo);
      if (answer.busFrom) check(row, 'data-guest-bus-from', answer.busFrom);
      if (answer.dinner) check(row, 'data-guest-dinner', answer.dinner);
    }
    extras.hidden = checked(row, 'data-guest-attending') !== 'yes';
    otherField.hidden = !otherToggle.checked;
    row.addEventListener('change', event => {
      const target = event.target as HTMLElement;
      if (target === otherToggle) {
        otherField.hidden = !otherToggle.checked;
        if (otherToggle.checked) otherInput.focus();
        return;
      }
      if (!target.matches('[data-guest-attending]')) return;
      extras.hidden = checked(row, 'data-guest-attending') !== 'yes';
      showError(attendError, null);
    });

    guestList.append(row);
    return row;
  }

  // ---- Reading and checking the form ---------------------------------------

  function dietaryOf(row: HTMLElement) {
    const choices = [...row.querySelectorAll<HTMLInputElement>('[data-guest-diet]:checked')].map(box => box.value);
    const other = $<HTMLInputElement>('[data-guest-diet-other]', row).checked ? $<HTMLInputElement>('[data-guest-dietary-other]', row).value : '';
    return formatDietary(choices, other);
  }

  function collect(party: RememberedParty): Rsvp {
    const guests = rows().map((row): GuestReply => {
      const attending = checked(row, 'data-guest-attending') as Answer;
      const coming = attending === 'yes';
      return {
        name: row.dataset.name!,
        attending,
        dietary: coming ? dietaryOf(row) : '',
        busTo: coming ? checked(row, 'data-guest-bus-to') : '',
        busFrom: coming ? checked(row, 'data-guest-bus-from') : '',
        dinner: coming ? checked(row, 'data-guest-dinner') as Answer | '' : '',
      };
    });
    return {
      submitted_at: new Date().toISOString(),
      code: party.code,
      party: party.greeting,
      song: field('song').value.trim(),
      message: field('message').value.trim(),
      notes: field('notes').value.trim(),
      guests,
    };
  }

  /** Marks every problem and returns the first control to fix, or null if the form is complete. */
  function validate(): HTMLElement | null {
    let first: HTMLElement | null = null;
    const flag = (control: HTMLElement) => { first ??= control; };
    for (const row of rows()) {
      const unanswered = !checked(row, 'data-guest-attending');
      showError($('[data-guest-attend-error]', row), unanswered ? `Let us know if ${row.dataset.name} can make it.` : null);
      if (unanswered) flag($('[data-guest-attending]', row));
    }
    return first;
  }

  // ---- Sending --------------------------------------------------------------

  async function send(rsvp: Rsvp) {
    if (!ENDPOINT) {
      if (!import.meta.env.DEV) throw new Error('PUBLIC_RSVP_ENDPOINT was empty at build time');
      console.info('[rsvp] No PUBLIC_RSVP_ENDPOINT set; this would have been sent:', rsvp);
      await new Promise(resolve => setTimeout(resolve, 700));
      return;
    }
    // Apps Script doesn't send CORS headers, so the response is opaque:
    // fetch resolving is the only success signal there is.
    await fetch(ENDPOINT, { method: 'POST', mode: 'no-cors', body: toParams(rsvp) });
  }

  // ---- The three states ----------------------------------------------------

  function showNoLink() {
    noLink.hidden = false;
    form.hidden = true;
    thanks.hidden = true;
  }

  function showForm(party: RememberedParty, previous: Rsvp | null) {
    guestList.replaceChildren();
    party.guests.forEach((name, i) => {
      const answer = previous?.guests.find(g => g.name === name) ?? previous?.guests[i];
      addRow(name, answer && { ...answer, name });
    });
    submit.textContent = party.guests.length > 1 ? 'Send our reply' : 'Send my reply';
    setHeading(`${party.greeting}, we’d love to`, 'know you’re coming.');
    field('song').value = previous?.song ?? '';
    field('message').value = previous?.message ?? '';
    field('notes').value = previous?.notes ?? '';
    subtitle.textContent = `Please reply by ${replyBy}.`;
    loading.hidden = true;
    thanks.hidden = true;
    form.hidden = false;
  }

  function showThanks(party: RememberedParty, rsvp: Rsvp, justSent: boolean) {
    const anyoneComing = rsvp.guests.some(g => g.attending === 'yes');
    setHeading(`Thank you, ${party.greeting}.`, anyoneComing ? 'See you in the garden.' : 'We’ll miss you.');
    subtitle.textContent = 'Here’s what you told us.';
    $('[data-rsvp-summary]').replaceChildren(...rsvp.guests.map(guest => {
      const item = document.createElement('li');
      const [who, ...rest] = describeGuest(guest).split(': ');
      item.append(Object.assign(document.createElement('strong'), { textContent: `${who}:` }), ` ${rest.join(': ')}`);
      return item;
    }));
    const on = sentOn(rsvp.submitted_at);
    $('[data-rsvp-received-text]').textContent = justSent ? 'Your RSVP has been sent' : on ? `We received your RSVP on ${on}` : 'We have your RSVP';
    $('[data-rsvp-reach]').textContent = `You can change your answer any time before ${replyBy}.`;
    const song = $('[data-rsvp-song]');
    song.hidden = !rsvp.song;
    song.textContent = rsvp.song ? `Your song request: ${rsvp.song}.` : '';
    const notes = $('[data-rsvp-notes]');
    notes.hidden = !rsvp.notes;
    notes.textContent = rsvp.notes ? `You also told us: ${rsvp.notes}` : '';
    $('[data-rsvp-change]').textContent = rsvp.guests.length > 1 ? 'Change our answer' : 'Change my answer';
    loading.hidden = true;
    form.hidden = true;
    thanks.hidden = false;
    if (justSent) {
      heading.focus({ preventScroll: true });
      root.scrollIntoView({ block: 'start', behavior: matchMedia('(prefers-reduced-motion: reduce)').matches ? 'auto' : 'smooth' });
    }
  }

  // ---- Starting up ----------------------------------------------------------

  /** The last reply this device sent or saw. */
  function savedReply(party: RememberedParty): Rsvp | null {
    try { return readSaved(localStorage.getItem(storageKey(party.code))); } catch { return null; }
  }

  function saveReply(party: RememberedParty, rsvp: Rsvp) {
    try { localStorage.setItem(storageKey(party.code), JSON.stringify(rsvp)); } catch {}
  }

  /** The Party's reply as the Sheet has it, from whichever device sent it.
      Null when there's none, or the Sheet can't be reached in time. */
  async function sheetReply(party: RememberedParty): Promise<Rsvp | null> {
    try {
      const response = await fetch(lookupUrl(ENDPOINT, party.code), { signal: AbortSignal.timeout(5000) });
      return response.ok ? readLookup(await response.json(), party.code) : null;
    } catch {
      return null;
    }
  }

  function start(party: RememberedParty) {
    // Once the guest sends or starts changing a reply here, a Sheet answer
    // arriving late must not replace it.
    let settled = false;

    form.addEventListener('submit', async event => {
      event.preventDefault();
      failure.hidden = true;
      const invalid = validate();
      if (invalid) { invalid.focus(); return; }

      const rsvp = collect(party);
      const label = submit.textContent;
      submit.disabled = true;
      submit.textContent = 'Sending…';
      try {
        await send(rsvp);
        settled = true;
      } catch (error) {
        console.error('[rsvp] Sending failed', error);
        failure.hidden = false;
        return;
      } finally {
        submit.disabled = false;
        submit.textContent = label;
      }
      saveReply(party, rsvp);
      showThanks(party, rsvp, true);
    });

    $('[data-rsvp-change]').addEventListener('click', () => {
      settled = true;
      showForm(party, savedReply(party));
      root.scrollIntoView({ block: 'start' });
      rows()[0]?.querySelector<HTMLInputElement>('input')?.focus({ preventScroll: true });
    });

    // Show this device's copy straight away, then check the Sheet for a newer one.
    const saved = savedReply(party);
    if (saved) showThanks(party, saved, false);
    if (!ENDPOINT) {
      if (!saved) showForm(party, null);
      return;
    }
    if (!saved) {
      setHeading(`${party.greeting}, we’d love to`, 'know you’re coming.');
      loading.hidden = false;
    }
    sheetReply(party).then(remote => {
      if (settled) return;
      const latest = latestReply(savedReply(party), remote);
      if (latest && latest === remote) {
        saveReply(party, remote);
        showThanks(party, remote, false);
      } else if (!saved) {
        showForm(party, null);
      }
    });
  }

  if (party) start(party);
  else showNoLink();
</script>

<style>
  .rsvp { scroll-margin-top: calc(var(--info-header-h, 74px) + 50px); }
  .rsvp [hidden] { display: none !important; }
  .rsvp a { color: inherit; text-decoration: none; border-bottom: 1px solid currentColor; }
  .rsvp a:focus-visible { outline: 2px solid #6e775c; outline-offset: 4px; }

  .rsvp-heading { font: 400 clamp(42px, 4.4vw, 66px)/1 'Cormorant Garamond', Georgia, serif; letter-spacing: -.045em; margin: 22px 0 18px; }
  /* The script builds these children, so they carry no scope attribute. */
  .rsvp-heading :global(em) { font-weight: 300; color: #59634f; }
  .rsvp-heading:focus { outline: none; }
  .rsvp-subtitle { font: italic 23px 'Cormorant Garamond', Georgia, serif; color: #59634f; margin: 0; }

  .rsvp-form, .rsvp-thanks { max-width: 520px; margin: 44px auto 0; text-align: left; }
  .rsvp-no-link { max-width: 460px; margin: 30px auto 0; }
  .rsvp-loading { margin-top: 44px; color: var(--muted); }
  @media (prefers-reduced-motion: no-preference) {
    /* Quick lookups finish before this shows at all. */
    .rsvp-loading { animation: rsvp-appear .5s .4s both; }
  }
  @keyframes rsvp-appear { from { opacity: 0; } }
  fieldset { border: 0; margin: 0; padding: 0; min-width: 0; }
  legend { padding: 0; }

  .rsvp-guests { border-bottom: 1px solid #7379672e; }
  .rsvp-guest { padding: 28px 0 30px; border-top: 1px solid #7379672e; }
  .rsvp-guest-name { font: 500 27px 'Cormorant Garamond', Georgia, serif; letter-spacing: -.02em; margin-bottom: 14px; }

  .rsvp-pills { display: flex; gap: 10px; }
  .rsvp-pill { position: relative; flex: 1; }
  .rsvp-pills-bus { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 8px; }
  .rsvp-pills-bus .rsvp-pill span { padding: 14px 6px; }
  .rsvp-pill input { position: absolute; inset: 0; margin: 0; opacity: 0; cursor: pointer; }
  .rsvp-pill span { display: block; text-align: center; font: 500 12px 'Montserrat', sans-serif; letter-spacing: .08em; text-transform: uppercase;
    padding: 16px 12px; border: 1px solid #7379677a; color: var(--ink); transition: background-color .2s, color .2s, border-color .2s; }
  .rsvp-pill input:checked + span { background: var(--deep); border-color: var(--deep); color: #f6f3e7; }
  .rsvp-pill input:focus-visible + span { outline: 2px solid #6e775c; outline-offset: 3px; }
  @media (hover: hover) { .rsvp-pill input:not(:checked):hover + span { border-color: var(--deep); } }

  .rsvp-extras { margin-top: 6px; padding-left: 20px; border-left: 1px solid #7a826d66; }
  .rsvp-dietary { margin-top: 24px; }
  .rsvp-dietary legend { margin-bottom: 12px; }
  .rsvp-pills-diet { display: grid; grid-template-columns: repeat(auto-fit, minmax(140px, 1fr)); }
  .rsvp-diet-other { margin-top: 14px; }
  .rsvp-bus { margin-top: 24px; }
  .rsvp-bus + .rsvp-hint { margin-top: 12px; }
  .rsvp-dinner { margin-top: 24px; }
  .rsvp-dinner legend { margin-bottom: 12px; }
  .rsvp-bus legend { margin-bottom: 12px; }

  .rsvp-field { display: block; margin-top: 24px; }
  .rsvp-label { display: block; font-size: 9px; text-transform: uppercase; letter-spacing: .22em; line-height: 1.8; color: var(--muted); }
  .rsvp-label i { font-style: normal; letter-spacing: .12em; margin-left: 6px; opacity: .65; }
  .rsvp-input { display: block; width: 100%; box-sizing: border-box; margin-top: 4px; padding: 6px 0 8px; border: 0; border-bottom: 1px solid #7379677a;
    border-radius: 0; background: transparent; color: var(--ink); font: 21px/1.35 'Cormorant Garamond', Georgia, serif; }
  textarea.rsvp-input { resize: vertical; min-height: 64px; }
  .rsvp-input:focus { outline: none; border-bottom-color: var(--deep); box-shadow: 0 1px 0 var(--deep); }
  .rsvp-input[aria-invalid='true'] { border-bottom-color: #8b6158; }

  .rsvp-error, .rsvp-hint, .rsvp-failure, .rsvp-note { font: italic 17px/1.4 'Cormorant Garamond', Georgia, serif; margin: 8px 0 0; }
  .rsvp-error, .rsvp-failure { color: #8b6158; }
  .rsvp-hint { color: var(--muted); font-size: 16px; }
  .rsvp-note { color: #59634f; font-size: 19px; margin-top: 18px; }

  .rsvp-party { margin-top: 12px; }

